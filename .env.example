PORT=3030
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=geul,deployment.environment=development

DATABASE_DSN=postgres://geul_asset_optimizer:change-me@postgres:5432/geul?sslmode=disable

S3_MEDIA_BUCKET=media
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

GLTF_TRANSFORM_PATH=gltf-transform
NODE_BINARY_PATH=node
PARTICLE_MESH_SCRIPT_PATH=scripts/optimize-particle-mesh.mjs
ASSET_OPTIMIZER_TEMP_DIR=/tmp/asset-optimizer
MAX_INPUT_BYTES=52428800

WORKER_COUNT=1
JOB_TIMEOUT_MINUTES=20
